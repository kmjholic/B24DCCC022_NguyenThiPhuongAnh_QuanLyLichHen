<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/primary"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/tvBack"
            style="@style/HeaderTitle"
            android:layout_marginEnd="20dp"
            android:text="←" />

        <TextView
            style="@style/HeaderTitle"
            android:text="Thêm lịch hẹn" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- 1. Tên lịch hẹn -->
            <TextView
                style="@style/FieldLabel"
                android:text="Tên lịch hẹn" />

            <EditText
                android:id="@+id/edtTitle"
                style="@style/Field"
                android:hint="Ví dụ: Họp nhóm đồ án"
                android:inputType="textCapSentences" />

            <!-- 2. Địa điểm -->
            <TextView
                style="@style/FieldLabel"
                android:text="Địa điểm" />

            <EditText
                android:id="@+id/edtLocation"
                style="@style/Field"
                android:hint="Ví dụ: Phòng B203"
                android:inputType="textCapSentences" />

            <!-- 3. Ngày hẹn -->
            <TextView
                style="@style/FieldLabel"
                android:text="Ngày hẹn" />

            <DatePicker
                android:id="@+id/datePicker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_field"
                android:calendarViewShown="false"
                android:datePickerMode="spinner"
                android:spinnersShown="true" />

            <!-- 4. Giờ hẹn -->
            <TextView
                style="@style/FieldLabel"
                android:text="Giờ hẹn" />

            <TimePicker
                android:id="@+id/timePicker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_field"
                android:timePickerMode="spinner" />

            <!-- 5. Nhắc nhở -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Nhắc nhở trước giờ hẹn"
                    android:textColor="@color/text_main"
                    android:textSize="17sp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swReminder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    app:thumbTint="@color/switch_thumb"
                    app:trackTint="@color/switch_track" />
            </LinearLayout>

            <!-- 6. Nút Lưu lịch hẹn -->
            <Button
                android:id="@+id/btnSave"
                style="@style/BigButton"
                android:layout_marginTop="20dp"
                android:text="Lưu lịch hẹn" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
